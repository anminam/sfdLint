{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "std-lint compact report v1",
  "description": "CLI --format compact-json 전용 응답입니다. 오류만 모으고 경고는 summary에만 집계합니다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "passed", "exitCode", "summary", "report"],
  "properties": {
    "version": { "const": 1 },
    "passed": { "type": "boolean" },
    "exitCode": { "type": "integer", "enum": [0, 1, 2] },
    "summary": { "$ref": "report.schema.json#/definitions/summary" },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isError", "errorFiles"],
      "properties": {
        "isError": { "type": "boolean" },
        "errorFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["filePath", "errorMessage"],
            "properties": {
              "filePath": { "type": "string" },
              "errorMessage": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
